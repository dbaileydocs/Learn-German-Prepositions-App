      { id: `a-dat-def`, type: `art`, frontTag: `Indirect Object Drill`, term: `der · die · das · die → ?`, prompt: `Transform all four definite articles for an indirect object (Wem?) or after "mit / aus / zu".`, backCase: `Dativ`, answer: `dem (M) · der (F) · dem (N) · den + -n (Pl)`, detail: `All genders change: M/N → dem, F → der, Plural → den (+ -n on noun unless ending in -n or -s).`, example: `mit dem Mann · mit der Frau · mit dem Kind · mit den Kindern` },
      { id: `a-dat-indef`, type: `art`, frontTag: `Indefinite & Negative`, term: `ein · eine · ein · keine → ?`, prompt: `Transform indefinite and negative articles for an indirect object (Wem?).`, backCase: `Dativ`, answer: `einem / keinem (M) · einer / keiner (F) · einem / keinem (N) · keinen + -n (Pl)`, detail: `M/N take -em, F takes -er, Plural takes -en (+ -n on noun).`, example: `nach einem Monat · nach einer Woche · mit keinen Problemen` },
      { id: `a-dat-poss`, type: `art`, frontTag: `Possessive Drill`, term: `mein · meine · mein · meine → ?`, prompt: `Transform possessive articles ("my") for an indirect object (Wem?).`, backCase: `Dativ`, answer: `meinem (M) · meiner (F) · meinem (N) · meinen + -n (Pl)`, detail: `Possessives follow the exact same -em / -er / -em / -en endings.`, example: `Ich fahre mit meinem Bruder und meiner Mutter.` },
      { id: `a-dat-pron`, type: `art`, frontTag: `Personal Pronouns`, term: `ich, du, er, sie, es, wir, ihr, sie, Sie → ?`, prompt: `Recall all 9 personal pronouns for an indirect object (Wem?).`, backCase: `Dativ`, answer: `mir · dir · ihm · ihr · ihm · uns · euch · ihnen · Ihnen`, detail: `Used as indirect objects, with helfen/danken/gehören, and after aus/bei/mit/nach/seit/von/zu.`, example: `Wie geht es dir? / Ich danke Ihnen! / Er hilft mir.` },

      // Contractions
      { id: `c-im-ins`, type: `contr`, frontTag: `Contraction Pair`, term: `im  vs.  ins`, prompt: `Expand both contractions and state which answers "Wo?" vs "Wohin?".`, backCase: `Wechselpräposition`, answer: `im = in + dem · ins = in + das`, detail: `im (Dativ) indicates static location (Wo?). ins (Akkusativ) indicates movement into (Wohin?).`, example: `Ich bin im Kino. (Wo?) / Ich gehe ins Kino. (Wohin?)` },
      { id: `c-am-ans`, type: `contr`, frontTag: `Contraction Pair`, term: `am  vs.  ans`, prompt: `Expand both contractions and state their grammatical cases.`, backCase: `Wechselpräposition`, answer: `am = an + dem · ans = an + das`, detail: `am (Dativ) for position/days/dates; ans (Akkusativ) for movement towards.`, example: `Am Montag sitze ich am Fenster. / Ich gehe ans Fenster.` },
      { id: `c-zum-zur`, type: `contr`, frontTag: `Contraction Pair`, term: `zum  vs.  zur`, prompt: `Expand both contractions and identify their noun genders.`, backCase: `Dativ`, answer: `zum = zu + dem (M/N) · zur = zu + der (F)`, detail: `Since "zu" always takes Dativ, masculine/neuter use "zum" and feminine uses "zur".`, example: `Ich gehe zum Bahnhof (m), zum Büro (n) und zur Post (f).` },
      { id: `c-beim-vom`, type: `contr`, frontTag: `Contraction Pair`, term: `beim  &  vom`, prompt: `Expand both contractions and identify the case.`, backCase: `Dativ`, answer: `beim = bei + dem · vom = von + dem`, detail: `Used with masculine and neuter nouns after Dativ prepositions "bei" and "von".`, example: `Ich bin beim Arzt. / Er kommt vom Flughafen.` },
      { id: `c-aufs-fuers`, type: `contr`, frontTag: `Contraction Group`, term: `aufs · fürs · durchs · ums`, prompt: `Expand these contractions and identify the gender & case of the noun.`, backCase: `Akkusativ`, answer: `auf/für/durch/um + das (Neuter)`, detail: `Neuter definite article "das" merges with these prepositions in the Akkusativ case.`, example: `Sie legt das Buch aufs Regal. / Danke fürs Geschenk!` }
    ];

    // =========================================================================
    // 5. APPLICATION STATE & PERSISTENCE
    // =========================================================================
    const DEFAULT_STATE = {
      mode: `quiz`,
      category: `all`,
      prep: `all`,
      order: `shuffled`,
      currentIdx: 0,
      answeredIds: {},
      correctCount: 0,
      totalAnswered: 0,
      streak: 0,
      wrongIds: [],
      fcFilter: `all`,
      fcIndex: 0,
      fcStatus: {}
    };

    let appState = Object.assign({}, DEFAULT_STATE);
    let activePool = ALL_QUESTIONS.slice();
    let activeDeck = FLASHCARDS.slice();
    let currentQuestionAnswered = false;
    let isFlashcardFlipped = false;

    function saveState() {
      if (window.notebookAppApi && typeof window.notebookAppApi.setAppState === `function`) {
        window.notebookAppApi.setAppState(appState).catch(() => {});
      }
    }

    function populatePrepDropdown() {
      const sel = document.getElementById(`filter-prep`);
      if (!sel) return;
      const preps = Array.from(new Set(ALL_QUESTIONS.map((q) => q.prep))).sort((a, b) => a.localeCompare(b, `de`));
      preps.forEach((p) => {
        const opt = document.createElement(`option`);
        opt.value = p;
        opt.textContent = p;
        sel.appendChild(opt);
      });
    }

    function rebuildActivePool(preserveIdx) {
      let filtered = ALL_QUESTIONS;

      if (appState.category === `mistakes`) {
        const wrongSet = new Set(appState.wrongIds);
        filtered = filtered.filter((q) => wrongSet.has(q.id));
      } else if (appState.category !== `all`) {
        filtered = filtered.filter((q) => q.cat === appState.category);
      }

      if (appState.prep !== `all`) {
        filtered = filtered.filter((q) => q.prep === appState.prep);
      }

      if (appState.order === `sequential`) {
        filtered = filtered.slice().sort((a, b) => a.id - b.id);
      } else {
        filtered = seededShuffle(filtered, 777 + (appState.shuffleSalt || 0));
      }

      activePool = filtered;
      if (!preserveIdx || appState.currentIdx >= activePool.length) {
        appState.currentIdx = 0;
      }
    }

    function updateHeaderStats() {
      const accEl = document.getElementById(`stat-accuracy`);
      const ansEl = document.getElementById(`stat-answered`);
      const strEl = document.getElementById(`stat-streak`);

      const pct = appState.totalAnswered > 0
        ? Math.round((appState.correctCount / appState.totalAnswered) * 100)
        : 0;
      const uniqueDone = Object.keys(appState.answeredIds).length;

      if (accEl) accEl.textContent = `${pct}%`;
      if (ansEl) ansEl.textContent = `${uniqueDone} / ${ALL_QUESTIONS.length}`;
      if (strEl) strEl.textContent = String(appState.streak);
    }

    function renderQuizQuestion() {
      const poolBadge = document.getElementById(`pool-badge`);
      const counterEl = document.getElementById(`q-counter`);
      const catPill = document.getElementById(`q-category-pill`);
      const progFill = document.getElementById(`quiz-progress-fill`);
      const sentDe = document.getElementById(`q-sentence-de`);
      const sentEn = document.getElementById(`q-sentence-en`);
      const hintBtn = document.getElementById(`btn-hint`);
      const hintTxt = document.getElementById(`q-hint-text`);
      const feedbackPanel = document.getElementById(`feedback-panel`);
      const prevBtn = document.getElementById(`btn-prev-q`);
      const nextBtn = document.getElementById(`btn-next-q`);

      if (poolBadge) {
        poolBadge.textContent = `Pool: ${activePool.length} ${activePool.length === 1 ? `question` : `questions`}`;
      }

      // Empty state for Review Mistakes
      if (activePool.length === 0) {
        if (counterEl) counterEl.textContent = `No questions in this filter`;
        if (catPill) {
          catPill.className = `pill`;
          catPill.textContent = `Empty`;
        }
        if (progFill) progFill.style.width = `0%`;
        if (sentDe) sentDe.innerHTML = `No mistakes to review right now.`;
        if (sentEn) sentEn.textContent = `Switch back to "All Categories" or choose another preposition to continue practising.`;
        if (hintBtn) hintBtn.classList.add(`hidden`);
        if (hintTxt) hintTxt.classList.add(`hidden`);
        if (feedbackPanel) feedbackPanel.className = `feedback-panel`;
        document.querySelectorAll(`.choice-btn`).forEach((b) => {
          b.disabled = true;
          b.classList.remove(`is-correct`, `is-wrong`);
        });
        if (prevBtn) prevBtn.disabled = true;
        if (nextBtn) nextBtn.disabled = true;
        return;
      }

      const q = activePool[appState.currentIdx];
      currentQuestionAnswered = false;

      if (counterEl) {
        counterEl.textContent = `Question ${appState.currentIdx + 1} of ${activePool.length} (#${q.id})`;
      }
      if (catPill) {
        if (q.cat === `akk`) {
          catPill.className = `pill pill-akk`;
          catPill.textContent = `Akkusativ · "${q.prep}"`;
        } else if (q.cat === `dat`) {
          catPill.className = `pill pill-dat`;
          catPill.textContent = `Dativ · "${q.prep}"`;
        } else {
          catPill.className = `pill pill-wech`;
          catPill.textContent = `Wechselpräposition · "${q.prep}"`;
        }
      }
      if (progFill) {
        const pct = Math.round(((appState.currentIdx + 1) / activePool.length) * 100);
        progFill.style.width = `${pct}%`;
      }

      if (sentDe) {
        sentDe.innerHTML = `${q.beforeBlank} <span class="blank-slot" id="blank-slot">___</span> ${q.afterBlank}`;
      }
      if (sentEn) sentEn.textContent = q.en;

      if (hintBtn) {
        hintBtn.classList.remove(`hidden`);
        hintBtn.textContent = `Show Noun Gender Hint`;
      }
      if (hintTxt) {
        hintTxt.classList.add(`hidden`);
        hintTxt.textContent = `Noun: ${q.nounDe} — ${q.genderLabel}`;
      }

      if (feedbackPanel) {
        feedbackPanel.className = `feedback-panel`;
      }

      document.querySelectorAll(`.choice-btn`).forEach((btn) => {
        btn.disabled = false;
        btn.classList.remove(`is-correct`, `is-wrong`);
      });

      if (prevBtn) prevBtn.disabled = appState.currentIdx === 0;
      if (nextBtn) {
        nextBtn.disabled = false;
        nextBtn.textContent = appState.currentIdx >= activePool.length - 1 ? `Restart Pool ↻` : `Next Question →`;
      }
    }

    // =========================================================================
    // 6. QUIZ INTERACTION HANDLERS (No auto-advance!)
    // =========================================================================
    function selectAnswer(chosen) {
      if (activePool.length === 0 || currentQuestionAnswered) return;
      const q = activePool[appState.currentIdx];
      currentQuestionAnswered = true;

      const isCorrect = (chosen === q.answer);
      const slot = document.getElementById(`blank-slot`);
      const feedbackPanel = document.getElementById(`feedback-panel`);
      const feedbackTitle = document.getElementById(`feedback-title`);
      const feedbackDetail = document.getElementById(`feedback-detail`);

      if (slot) {
        slot.textContent = q.answer;
        slot.classList.add(isCorrect ? `is-correct` : `is-wrong`);
      }

      document.querySelectorAll(`.choice-btn`).forEach((btn) => {
        btn.disabled = true;
        const art = btn.getAttribute(`data-art`);
        if (art === q.answer) {
          btn.classList.add(`is-correct`);
        } else if (art === chosen && !isCorrect) {
          btn.classList.add(`is-wrong`);
        }
      });

      if (feedbackPanel && feedbackTitle && feedbackDetail) {
        feedbackPanel.className = `feedback-panel is-visible ${isCorrect ? `is-correct` : `is-wrong`}`;
        feedbackTitle.textContent = isCorrect
          ? `Correct! "${q.answer}" (${q.caseName})`
          : `Not quite — the correct article is "${q.answer}" (${q.caseName}).`;
        feedbackDetail.textContent = q.explanation;
      }

      appState.totalAnswered += 1;
      appState.answeredIds[q.id] = isCorrect ? `ok` : `err`;
      if (isCorrect) {
        appState.correctCount += 1;
        appState.streak += 1;
        appState.wrongIds = appState.wrongIds.filter((id) => id !== q.id);
      } else {
        appState.streak = 0;
        if (!appState.wrongIds.includes(q.id)) {
          appState.wrongIds.push(q.id);
        }
      }

      updateHeaderStats();
      saveState();
    }

    function nextQuestion() {
      if (activePool.length === 0) return;
      if (appState.currentIdx < activePool.length - 1) {
        appState.currentIdx += 1;
      } else {
        appState.currentIdx = 0;
      }
      renderQuizQuestion();
      saveState();
    }

    function prevQuestion() {
      if (activePool.length === 0 || appState.currentIdx <= 0) return;
      appState.currentIdx -= 1;
      renderQuizQuestion();
      saveState();
    }

    function toggleHint() {
      const hintTxt = document.getElementById(`q-hint-text`);
      const hintBtn = document.getElementById(`btn-hint`);
      if (!hintTxt || !hintBtn) return;
      const hidden = hintTxt.classList.contains(`hidden`);
      if (hidden) {
        hintTxt.classList.remove(`hidden`);
        hintBtn.textContent = `Hide Noun Gender Hint`;
      } else {
        hintTxt.classList.add(`hidden`);
        hintBtn.textContent = `Show Noun Gender Hint`;
      }
    }

    function applyQuizFilter() {
      const catSel = document.getElementById(`filter-category`);
      const prepSel = document.getElementById(`filter-prep`);
      if (catSel) appState.category = catSel.value;
      if (prepSel) appState.prep = prepSel.value;
      rebuildActivePool(false);
      renderQuizQuestion();
      saveState();
    }

    function applyQuizOrder() {
      const ordSel = document.getElementById(`filter-order`);
      if (ordSel) appState.order = ordSel.value;
      rebuildActivePool(false);
      renderQuizQuestion();
      saveState();
    }

    function reshuffleCurrentPool() {
      appState.shuffleSalt = (appState.shuffleSalt || 0) + 1;
      appState.order = `shuffled`;
      const ordSel = document.getElementById(`filter-order`);
      if (ordSel) ordSel.value = `shuffled`;
      rebuildActivePool(false);
      renderQuizQuestion();
      saveState();
    }

    // =========================================================================
    // 7. FLASHCARDS LOGIC (Zero case hints on card fronts!)
    // =========================================================================
    function rebuildFlashcardDeck(preserveIdx) {
      let deck = FLASHCARDS;
      if (appState.fcFilter === `prep`) {
        deck = FLASHCARDS.filter((c) => c.type === `prep`);
      } else if (appState.fcFilter === `art`) {
        deck = FLASHCARDS.filter((c) => c.type === `art`);
      } else if (appState.fcFilter === `contr`) {
        deck = FLASHCARDS.filter((c) => c.type === `contr`);
      } else if (appState.fcFilter === `review`) {
        deck = FLASHCARDS.filter((c) => appState.fcStatus[c.id] === `review`);
      }

      if (appState.fcShuffleSalt) {
        deck = seededShuffle(deck, 505 + appState.fcShuffleSalt);
      }

      activeDeck = deck;
      if (!preserveIdx || appState.fcIndex >= activeDeck.length) {
        appState.fcIndex = 0;
      }
    }

    function renderFlashcard() {
      const btn = document.getElementById(`flashcard-btn`);
      const masteryBadge = document.getElementById(`fc-mastery-badge`);
      const counterF = document.getElementById(`fc-counter`);
      const counterB = document.getElementById(`fc-counter-back`);
      const frontType = document.getElementById(`fc-front-type`);
      const frontTerm = document.getElementById(`fc-front-term`);
      const frontPrompt = document.getElementById(`fc-front-prompt`);
      const backCase = document.getElementById(`fc-back-case`);
      const backAnswer = document.getElementById(`fc-back-answer`);
      const backDetail = document.getElementById(`fc-back-detail`);
      const backExample = document.getElementById(`fc-back-example`);
      const statusF = document.getElementById(`fc-status-front`);
      const statusB = document.getElementById(`fc-status-back`);

      const masteredTotal = Object.values(appState.fcStatus).filter((v) => v === `mastered`).length;
      if (masteryBadge) {
        masteryBadge.textContent = `${masteredTotal} / ${FLASHCARDS.length} mastered`;
      }

      isFlashcardFlipped = false;
      if (btn) btn.classList.remove(`is-flipped`);

      // Update filter button active styling
      [`all`, `prep`, `art`, `contr`, `review`].forEach((f) => {
        const fBtn = document.getElementById(`fc-filter-${f}`);
        if (!fBtn) return;
        if (appState.fcFilter === f) {
          fBtn.classList.add(`btn-primary`);
        } else {
          fBtn.classList.remove(`btn-primary`);
        }
      });

      if (activeDeck.length === 0) {
        if (counterF) counterF.textContent = `0 cards`;
        if (counterB) counterB.textContent = `0 cards`;
        if (frontType) frontType.textContent = `Empty`;
        if (frontTerm) frontTerm.textContent = `No cards marked for review`;
        if (frontPrompt) frontPrompt.textContent = `Select "All Cards" above or mark challenging cards as "Mark for Review".`;
        if (statusF) statusF.textContent = ``;
        return;
      }

      const card = activeDeck[appState.fcIndex];
      const countText = `Card ${appState.fcIndex + 1} of ${activeDeck.length}`;
      const st = appState.fcStatus[card.id];
      const statusLabel = st === `mastered` ? `Mastered ✓` : (st === `review` ? `Needs Review` : `Unreviewed`);

      if (counterF) counterF.textContent = countText;
      if (counterB) counterB.textContent = countText;
      if (frontType) frontType.textContent = card.frontTag;
      if (frontTerm) frontTerm.textContent = card.term;
      if (frontPrompt) frontPrompt.textContent = card.prompt;

      if (backCase) backCase.textContent = card.backCase;
      if (backAnswer) backAnswer.textContent = card.answer;
      if (backDetail) backDetail.textContent = card.detail;
      if (backExample) backExample.textContent = card.example;

      if (statusF) statusF.textContent = statusLabel;
      if (statusB) statusB.textContent = statusLabel;
    }

    function flipFlashcard() {
      if (activeDeck.length === 0) return;
      isFlashcardFlipped = !isFlashcardFlipped;
      const btn = document.getElementById(`flashcard-btn`);
      if (btn) btn.classList.toggle(`is-flipped`, isFlashcardFlipped);
    }

    function nextFlashcard() {
      if (activeDeck.length === 0) return;
      appState.fcIndex = (appState.fcIndex + 1) % activeDeck.length;
      renderFlashcard();
      saveState();
    }

    function prevFlashcard() {
      if (activeDeck.length === 0) return;
      appState.fcIndex = (appState.fcIndex - 1 + activeDeck.length) % activeDeck.length;
      renderFlashcard();
      saveState();
    }

    function setFlashcardFilter(filterName) {
      appState.fcFilter = filterName;
      rebuildFlashcardDeck(false);
      renderFlashcard();
      saveState();
    }

    function shuffleFlashcards() {
      appState.fcShuffleSalt = (appState.fcShuffleSalt || 0) + 1;
      rebuildFlashcardDeck(false);
      renderFlashcard();
      saveState();
    }

    function markFlashcard(statusVal) {
      if (activeDeck.length === 0) return;
      const card = activeDeck[appState.fcIndex];
      appState.fcStatus[card.id] = statusVal;
      nextFlashcard();
      saveState();
    }

    // =========================================================================
    // 8. MODE SWITCHING, RESET & KEYBOARD SHORTCUTS
    // =========================================================================
    function switchMode(mode) {
      appState.mode = mode;
      const quizPanel = document.getElementById(`panel-quiz`);
      const fcPanel = document.getElementById(`panel-flashcards`);
      const tabQuiz = document.getElementById(`tab-quiz`);
      const tabFc = document.getElementById(`tab-flashcards`);

      if (mode === `flashcards`) {
        if (quizPanel) quizPanel.classList.add(`hidden`);
        if (fcPanel) fcPanel.classList.remove(`hidden`);
        if (tabQuiz) tabQuiz.classList.remove(`btn-primary`);
        if (tabFc) tabFc.classList.add(`btn-primary`);
        renderFlashcard();
      } else {
        if (fcPanel) fcPanel.classList.add(`hidden`);
        if (quizPanel) quizPanel.classList.remove(`hidden`);
        if (tabFc) tabFc.classList.remove(`btn-primary`);
        if (tabQuiz) tabQuiz.classList.add(`btn-primary`);
        renderQuizQuestion();
      }
      saveState();
    }

    function handleResetProgress(btn) {
      if (btn.dataset.armed !== `true`) {
        btn.dataset.armed = `true`;
        btn.textContent = `Click again to reset`;
        setTimeout(() => {
          if (btn.dataset.armed === `true`) {
            btn.dataset.armed = `false`;
            btn.textContent = `Reset Progress`;
          }
        }, 3500);
        return;
      }

      btn.dataset.armed = `false`;
      btn.textContent = `Reset Progress`;

      appState = Object.assign({}, DEFAULT_STATE, { mode: appState.mode });
      const catSel = document.getElementById(`filter-category`);
      const prepSel = document.getElementById(`filter-prep`);
      const ordSel = document.getElementById(`filter-order`);
      if (catSel) catSel.value = `all`;
      if (prepSel) prepSel.value = `all`;
      if (ordSel) ordSel.value = `shuffled`;

      rebuildActivePool(false);
      rebuildFlashcardDeck(false);
      updateHeaderStats();
      switchMode(appState.mode);
      saveState();
    }

    document.addEventListener(`keydown`, (ev) => {
      const tag = ev.target && ev.target.tagName ? ev.target.tagName.toLowerCase() : ``;
      if (tag === `select` || tag === `input`) return;

      if (appState.mode === `quiz`) {
        const keyMap = { '1': `der`, '2': `die`, '3': `das`, '4': `den`, '5': `dem`, '6': `des` };
        if (keyMap[ev.key]) {
          selectAnswer(keyMap[ev.key]);
        } else if (ev.key === `Enter` && currentQuestionAnswered) {
          ev.preventDefault();
          nextQuestion();
        }
      } else if (appState.mode === `flashcards`) {
        if (ev.key === ` `) {
          ev.preventDefault();
          flipFlashcard();
        } else if (ev.key === `ArrowRight`) {
          nextFlashcard();
        } else if (ev.key === `ArrowLeft`) {
          prevFlashcard();
        }
      }
    });

    // =========================================================================
    // 9. INITIALISATION WITH NOTEBOOK SHIM API
    // =========================================================================
    async function initApp() {
      populatePrepDropdown();

      if (window.notebookAppApi && typeof window.notebookAppApi.getAppState === `function`) {
        try {
          const saved = await window.notebookAppApi.getAppState();
          if (saved && typeof saved === `object`) {
            appState = Object.assign({}, DEFAULT_STATE, saved);
            if (!appState.answeredIds) appState.answeredIds = {};
            if (!appState.wrongIds) appState.wrongIds = [];
            if (!appState.fcStatus) appState.fcStatus = {};
          }
        } catch (e) {
          // Proceed cleanly with default state
        }
      }

      const catSel = document.getElementById(`filter-category`);
      const prepSel = document.getElementById(`filter-prep`);
      const ordSel = document.getElementById(`filter-order`);
      if (catSel) catSel.value = appState.category;
      if (prepSel) prepSel.value = appState.prep;
      if (ordSel) ordSel.value = appState.order;

      rebuildActivePool(true);
      rebuildFlashcardDeck(true);
      updateHeaderStats();
      switchMode(appState.mode === `flashcards` ? `flashcards` : `quiz`);

      if (window.notebookAppApi && typeof window.notebookAppApi.notifyAppReady === `function`) {
        window.notebookAppApi.notifyAppReady();
      }
    }

    initApp();
  </script>
