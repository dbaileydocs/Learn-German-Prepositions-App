<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="artifact-type" content="tool">
  <meta name="design-style" content="canopy">
  <title>Deutsche Präpositionen — Interactive Practice &amp; Reference</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Literata:ital,opsz,wght@0,7..72,500;0,7..72,600;1,7..72,500&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      color-scheme: light;

      /* Clean green-tinted visual theme with soft green accents */
      --background: #f2f7f3;
      --surface-container-low: #ffffff;
      --surface-container: #e6f0e8;
      --surface-container-high: #d7e7da;

      /* Ink */
      --on-surface: #1e2d24;
      --on-surface-variant: #4a5e51;

      /* Lines */
      --outline: #8ba594;
      --outline-variant: #cde0d1;

      /* Soft green accents */
      --primary: #2e6b47;
      --primary-hover: #245538;
      --on-primary: #ffffff;
      --primary-container: #d8efe0;
      --on-primary-container: #19472c;
      --secondary: #4e6b58;
      --tertiary: #845424;
      --tertiary-container: #f5e2c4;
      --on-tertiary-container: #5f3a12;
      --info-container: #e2eff7;
      --on-info-container: #1b4965;
      --error: #b63835;
      --error-container: #fce8e7;
      --on-error-container: #7c1f1d;
      --on-error: #ffffff;

      /* Semantic & focus */
      --positive: #2e6b47;
      --warning: #845424;
      --focus: #2e6b47;

      /* Fonts */
      --font-headline: 'Literata', serif;
      --font-body: 'Nunito Sans', sans-serif;
      --font-label: 'Geist Mono', monospace;

      /* Type scale (Focused Tool) */
      --display-size: clamp(1.75rem, 1.35rem + 1.4vw, 2.35rem);
      --headline-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.55rem);
      --subhead-size: clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem);
      --body-size: clamp(0.9375rem, 0.9rem + 0.15vw, 1rem);
      --label-size: 0.75rem;

      /* Shape & effects */
      --rounded: 0.625rem;
      --rounded-lg: 1rem;
      --rounded-full: 9999px;
      --shadow-soft: 0 4px 18px rgb(30 45 36 / 0.06);
      --shadow-soft-hover: 0 8px 24px rgb(30 45 36 / 0.10);
      --border-crisp: 1px solid var(--outline-variant);
      --border-strong: 1.5px solid var(--outline);
      --focus-ring: 0 0 0 3px rgb(46 107 71 / 0.25);

      /* Spacing scale (4pt base) */
      --space-xs: 0.25rem;
      --space-sm: 0.5rem;
      --space-md: 1rem;
      --space-lg: 1.5rem;
      --space-xl: 2.5rem;
      --space-2xl: 3.5rem;

      /* Motion */
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-in-out: cubic-bezier(0.65, 0, 0.35, 1);
      --dur-micro: 120ms;
      --dur-short: 220ms;
      --dur-long: 380ms;
    }

    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      overflow-x: clip;
      margin: 0;
      padding: 0;
      background-color: var(--background);
      color: var(--on-surface);
      font-family: var(--font-body);
      font-size: var(--body-size);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    header { position: static !important; }

    button, input, select {
      font-family: inherit;
      font-size: inherit;
      color: inherit;
    }

    :focus-visible {
      outline: 2px solid var(--focus);
      outline-offset: 2px;
      box-shadow: var(--focus-ring);
    }

    .page-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-lg);
      padding: var(--space-lg);
      max-width: 1120px;
      margin: 0 auto;
    }
    .page-grid * { min-width: 0; }

    /* Header & KPI Strip */
    .app-header {
      background: var(--surface-container-low);
      border: var(--border-crisp);
      border-radius: var(--rounded-lg);
      padding: var(--space-lg);
      box-shadow: var(--shadow-soft);
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: var(--space-lg);
      align-items: center;
    }

    .kicker {
      font-family: var(--font-label);
      font-size: var(--label-size);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--primary);
      margin: 0 0 var(--space-xs) 0;
    }

    h1 {
      font-family: var(--font-headline);
      font-size: var(--display-size);
      font-weight: 600;
      line-height: 1.15;
      letter-spacing: -0.015em;
      margin: 0 0 var(--space-sm) 0;
      color: var(--on-surface);
    }

    .subtitle {
      margin: 0;
      color: var(--on-surface-variant);
      max-width: 60ch;
    }

    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-sm);
    }

    .kpi-tile {
      background: var(--surface-container);
      border: var(--border-crisp);
      border-radius: var(--rounded);
      padding: var(--space-md) var(--space-sm);
      text-align: center;
    }
    .kpi-tile.is-highlight {
      background: var(--primary-container);
      color: var(--on-primary-container);
    }

    .kpi-label {
      display: block;
      font-family: var(--font-label);
      font-size: var(--label-size);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--on-surface-variant);
      margin-bottom: var(--space-xs);
    }
    .kpi-tile.is-highlight .kpi-label {
      color: var(--on-primary-container);
    }

    .kpi-value {
      font-family: var(--font-headline);
      font-size: clamp(1.35rem, 1.1rem + 0.7vw, 1.75rem);
      font-weight: 600;
      font-variant-numeric: tabular-nums;
      line-height: 1.1;
    }

    /* Mode Switcher & Workspace Navigation */
    .workspace-bar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-md);
      background: var(--surface-container-low);
      border: var(--border-crisp);
      border-radius: var(--rounded-lg);
      padding: var(--space-sm) var(--space-md);
      box-shadow: var(--shadow-soft);
    }

    .mode-group {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-xs);
      min-height: 44px;
      padding: var(--space-sm) var(--space-md);
      border-radius: var(--rounded);
      border: var(--border-crisp);
      background: var(--surface-container);
      color: var(--on-surface);
      font-weight: 600;
      cursor: pointer;
      transition: background-color var(--dur-micro) var(--ease-out),
                  transform var(--dur-micro) var(--ease-out),
                  box-shadow var(--dur-micro) var(--ease-out);
      text-decoration: none;
    }
    .btn:hover:not(:disabled) {
      background: var(--surface-container-high);
      transform: translateY(-1px);
    }
    .btn:active:not(:disabled) {
      transform: translateY(0);
    }
    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .btn-primary {
      background: var(--primary);
      color: var(--on-primary);
      border-color: var(--primary);
    }
    .btn-primary:hover:not(:disabled) {
      background: var(--primary-hover);
      color: var(--on-primary);
    }

    .btn-ghost {
      background: transparent;
      border-color: var(--outline-variant);
    }

    .btn-sm {
      min-height: 44px;
      padding: var(--space-xs) var(--space-md);
      font-size: 0.875rem;
    }

    /* Cards */
    .card {
      background: var(--surface-container-low);
      border: var(--border-crisp);
      border-radius: var(--rounded-lg);
      padding: var(--space-lg);
      box-shadow: var(--shadow-soft);
    }

    .section-header {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-sm);
      margin-bottom: var(--space-md);
    }

    h2 {
      font-family: var(--font-headline);
      font-size: var(--headline-size);
      font-weight: 600;
      margin: 0;
      color: var(--on-surface);
    }

    h3 {
      font-family: var(--font-headline);
      font-size: var(--subhead-size);
      font-weight: 600;
      margin: 0 0 var(--space-sm) 0;
      color: var(--on-surface);
    }

    /* Quiz Controls Row */
    .controls-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
      gap: var(--space-md);
      align-items: end;
      margin-bottom: var(--space-lg);
      padding-bottom: var(--space-md);
      border-bottom: var(--border-crisp);
    }

    .field-group {
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
    }

    .field-label {
      font-family: var(--font-label);
      font-size: var(--label-size);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--on-surface-variant);
    }

    select.control-input {
      min-height: 44px;
      padding: var(--space-sm) var(--space-lg) var(--space-sm) var(--space-md);
      border: var(--border-crisp);
      border-radius: var(--rounded);
      background-color: var(--surface-container-low);
      color: var(--on-surface);
      font-weight: 600;
      cursor: pointer;
    }

    /* Quiz Stage */
    .quiz-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-sm);
      margin-bottom: var(--space-md);
    }

    .pill {
      display: inline-flex;
      align-items: center;
      padding: var(--space-xs) var(--space-sm);
      border-radius: var(--rounded-full);
      font-family: var(--font-label);
      font-size: var(--label-size);
      font-weight: 600;
      letter-spacing: 0.04em;
      background: var(--surface-container);
      color: var(--on-surface);
    }
    .pill-akk {
      background: var(--info-container);
      color: var(--on-info-container);
    }
    .pill-dat {
      background: var(--primary-container);
      color: var(--on-primary-container);
    }
    .pill-wech {
      background: var(--tertiary-container);
      color: var(--on-tertiary-container);
    }

    .progress-track {
      width: 100%;
      height: 8px;
      background: var(--surface-container);
      border-radius: var(--rounded-full);
      overflow: hidden;
      margin-bottom: var(--space-lg);
    }
    .progress-fill {
      height: 100%;
      background: var(--primary);
      border-radius: var(--rounded-full);
      transition: width var(--dur-short) var(--ease-out);
      width: 0%;
    }

    .prompt-box {
      background: var(--background);
      border: var(--border-crisp);
      border-radius: var(--rounded-lg);
      padding: var(--space-xl) var(--space-lg);
      margin-bottom: var(--space-lg);
      text-align: center;
    }

    .sentence-de {
      font-family: var(--font-headline);
      font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.85rem);
      font-weight: 500;
      line-height: 1.45;
      margin: 0 0 var(--space-sm) 0;
      color: var(--on-surface);
    }

    .blank-slot {
      display: inline-block;
      min-width: 3.4rem;
      padding: 0 var(--space-sm);
      margin: 0 var(--space-xs);
      border-bottom: 2.5px solid var(--primary);
      font-weight: 600;
      color: var(--primary);
      background: var(--primary-container);
      border-radius: var(--space-xs);
    }
    .blank-slot.is-correct {
      background: var(--primary-container);
      color: var(--on-primary-container);
      border-bottom-color: var(--positive);
    }
    .blank-slot.is-wrong {
      background: var(--error-container);
      color: var(--on-error-container);
      border-bottom-color: var(--error);
    }

    .sentence-en {
      margin: 0;
      color: var(--on-surface-variant);
      font-size: 0.975rem;
    }

    .hint-toggle-row {
      margin-top: var(--space-md);
      display: flex;
      justify-content: center;
      gap: var(--space-sm);
      flex-wrap: wrap;
    }

    .hint-text {
      margin-top: var(--space-sm);
      font-family: var(--font-label);
      font-size: 0.8125rem;
      color: var(--secondary);
    }

    /* Article Choice Grid */
    .choices-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-md);
      margin-bottom: var(--space-lg);
    }

    .choice-btn {
      min-height: 56px;
      padding: var(--space-md);
      border-radius: var(--rounded);
      border: var(--border-crisp);
      background: var(--surface-container-low);
      box-shadow: var(--shadow-soft);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: var(--space-sm);
      font-family: var(--font-headline);
      font-size: 1.25rem;
      font-weight: 600;
      color: var(--on-surface);
      transition: background-color var(--dur-micro) var(--ease-out),
                  transform var(--dur-micro) var(--ease-out),
                  box-shadow var(--dur-micro) var(--ease-out);
    }
    .choice-btn:hover:not(:disabled) {
      background: var(--surface-container);
      transform: translateY(-2px);
      box-shadow: var(--shadow-soft-hover);
    }
    .choice-btn:disabled {
      cursor: default;
    }

    .choice-key {
      font-family: var(--font-label);
      font-size: var(--label-size);
      color: var(--on-surface-variant);
      background: var(--surface-container);
      padding: 2px 7px;
      border-radius: var(--space-xs);
    }

    .choice-btn.is-correct {
      background: var(--primary);
      color: var(--on-primary);
      border-color: var(--primary);
    }
    .choice-btn.is-correct .choice-key {
      background: var(--primary-hover);
      color: var(--on-primary);
    }

    .choice-btn.is-wrong {
      background: var(--error-container);
      color: var(--on-error-container);
      border-color: var(--error);
    }
    .choice-btn.is-wrong .choice-key {
      background: var(--error);
      color: var(--on-error);
    }

    /* Feedback Banner */
    .feedback-panel {
      border-radius: var(--rounded);
      padding: var(--space-md) var(--space-lg);
      margin-bottom: var(--space-lg);
      border: var(--border-crisp);
      display: none;
    }
    .feedback-panel.is-visible {
      display: block;
    }
    .feedback-panel.is-correct {
      background: var(--primary-container);
      color: var(--on-primary-container);
    }
    .feedback-panel.is-wrong {
      background: var(--error-container);
      color: var(--on-error-container);
    }

    .feedback-title {
      font-family: var(--font-headline);
      font-weight: 600;
      font-size: 1.1rem;
      margin: 0 0 var(--space-xs) 0;
    }
    .feedback-detail {
      margin: 0;
      font-size: 0.95rem;
    }

    .quiz-footer {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-md);
    }

    /* Flashcards Section */
    .hidden { display: none !important; }

    .flashcard-controls {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-md);
      margin-bottom: var(--space-lg);
    }

    .deck-pills {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-sm);
    }

    .flashcard-stage {
      perspective: 1200px;
      margin-bottom: var(--space-lg);
    }

    .flashcard-btn {
      width: 100%;
      min-height: 290px;
      padding: 0;
      border: 0;
      background: transparent;
      cursor: pointer;
      text-align: left;
      position: relative;
      transform-style: preserve-3d;
      transition: transform var(--dur-long) var(--ease-in-out);
    }
    .flashcard-btn.is-flipped {
      transform: rotateY(180deg);
    }

    .flashcard-face {
      position: absolute;
      inset: 0;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      border-radius: var(--rounded-lg);
      padding: var(--space-xl);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      border: var(--border-crisp);
      box-shadow: var(--shadow-soft);
    }

    .flashcard-front {
      background: var(--surface-container-low);
      color: var(--on-surface);
    }

    .flashcard-back {
      background: var(--primary-container);
      color: var(--on-primary-container);
      transform: rotateY(180deg);
    }

    .fc-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-sm);
    }

    .fc-main {
      text-align: center;
      padding: var(--space-md) 0;
    }

    .fc-term {
      font-family: var(--font-headline);
      font-size: clamp(1.75rem, 1.3rem + 1.5vw, 2.5rem);
      font-weight: 600;
      margin: 0 0 var(--space-sm) 0;
      line-height: 1.2;
    }

    .fc-sub {
      margin: 0 auto;
      max-width: 52ch;
      font-size: 1rem;
      color: var(--on-surface-variant);
    }
    .flashcard-back .fc-sub {
      color: var(--on-primary-container);
    }

    .fc-example {
      margin-top: var(--space-md);
      padding: var(--space-sm) var(--space-md);
      background: var(--surface-container-low);
      color: var(--on-surface);
      border-radius: var(--rounded);
      display: inline-block;
      font-size: 0.95rem;
    }

    .fc-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-family: var(--font-label);
      font-size: var(--label-size);
      color: var(--on-surface-variant);
    }
    .flashcard-back .fc-footer {
      color: var(--on-primary-container);
    }

    .flashcard-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-md);
    }

    /* Reference Guide at Bottom */
    .reference-section {
      display: grid;
      gap: var(--space-lg);
      margin-top: var(--space-md);
      padding-top: var(--space-lg);
      border-top: var(--border-crisp);
    }

    .ref-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
      gap: var(--space-lg);
    }

    .ref-card {
      background: var(--surface-container-low);
      border: var(--border-crisp);
      border-radius: var(--rounded-lg);
      padding: var(--space-lg);
      box-shadow: var(--shadow-soft);
    }
    .ref-card.is-leaf-highlight {
      background: var(--primary-container);
      color: var(--on-primary-container);
    }

    .prep-list {
      list-style: none;
      padding: 0;
      margin: 0 0 var(--space-md) 0;
      display: grid;
      gap: var(--space-xs);
    }
    .prep-list li {
      display: flex;
      justify-content: space-between;
      gap: var(--space-sm);
      padding: var(--space-xs) 0;
      border-bottom: var(--border-crisp);
      font-size: 0.9375rem;
    }
    .prep-list li:last-child {
      border-bottom: 0;
    }
    .prep-word {
      font-weight: 700;
      color: var(--primary);
    }
    .ref-card.is-leaf-highlight .prep-word {
      color: var(--on-primary-container);
    }

    table.grammar-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.9rem;
      margin-top: var(--space-sm);
    }
    table.grammar-table th,
    table.grammar-table td {
      padding: var(--space-sm) var(--space-xs);
      text-align: left;
      border-bottom: var(--border-crisp);
    }
    table.grammar-table th {
      font-family: var(--font-label);
      font-size: var(--label-size);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--on-surface-variant);
      background: var(--surface-container);
    }
    .ref-card.is-leaf-highlight table.grammar-table th {
      background: var(--surface-container-low);
      color: var(--on-surface);
    }

    .contraction-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(170px, 100%), 1fr));
      gap: var(--space-sm);
    }
    .contraction-chip {
      background: var(--surface-container);
      border: var(--border-crisp);
      border-radius: var(--rounded);
      padding: var(--space-sm) var(--space-md);
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .contraction-chip strong {
      font-family: var(--font-headline);
      font-size: 1.05rem;
      color: var(--primary);
    }
    .contraction-chip span {
      font-family: var(--font-label);
      font-size: var(--label-size);
      color: var(--on-surface-variant);
    }

    .source-footer {
      text-align: center;
      color: var(--on-surface-variant);
      font-size: 0.875rem;
      padding: var(--space-md) 0 var(--space-xl) 0;
    }

    @media (max-width: 640px) {
      .page-grid {
        padding: var(--space-sm);
        gap: var(--space-md);
      }
      .app-header {
        grid-template-columns: 1fr;
        padding: var(--space-md);
      }
      .card, .ref-card {
        padding: var(--space-md);
      }
      .choices-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--space-sm);
